---
import BaseLayout from '../layouts/BaseLayout.astro';
import TiltCard from '../islands/TiltCard.tsx';

const services = [
  {
    n: '01',
    category: 'Data',
    title: 'Data & bookkeeping support',
    summary: 'Excel cleanup, monthly bookkeeping, custom reports.',
    bullets: [
      'Chart of accounts and ledger setup from receipts or messy sheets',
      'Monthly close, payables tracking, payroll reconciliation',
      'Custom reports (P&L, cash position, owner-readable summaries)',
    ],
    price: 'PHP 5,000 / month',
    priceNote: 'Starts at',
  },
  {
    n: '02',
    category: 'Web',
    title: 'Website + SEO',
    summary: 'Astro/Next sites, on-page SEO, Netlify deploys.',
    bullets: [
      'Design, build, and deploy on Astro or Next.js',
      'On-page SEO: titles, meta, schema, sitemaps',
      'Netlify hosting + form handling and analytics wiring',
    ],
    price: 'PHP 25,000 / project',
    priceNote: 'Starts at',
    featured: true,
  },
  {
    n: '03',
    category: 'AI',
    title: 'AI chatbot integration',
    summary: 'Botpress + Claude or GPT integrations, training data, handover docs.',
    bullets: [
      'Botpress flow with structured nodes for predictable answers',
      'Claude or GPT for open-ended turns; clean human handoff',
      'Training data, deploy, and a written handover doc your team can use',
    ],
    price: 'PHP 18,000 / project',
    priceNote: 'Starts at',
  },
];

const steps = [
  { n: 1, title: 'Discover', text: 'A short call to learn the business and the problem.' },
  { n: 2, title: 'Scope', text: 'A one-page brief: deliverable, timeline, price, what is out of scope.' },
  { n: 3, title: 'Build', text: 'Weekly check-ins with working drafts you can react to.' },
  { n: 4, title: 'Hand off', text: 'Docs, training, and a 30-day support window after launch.' },
];
---

<BaseLayout
  title="Services — Uzziel Malolos"
  description="Data, web, and AI services for small Philippine teams."
>
  <section class="container pb-14 pt-12 md:pt-16">
    <div class="ledger-head" data-reveal>
      <p class="eyebrow">Services · For small PH teams</p>
      <p class="meta-mono hidden sm:block">Scoped plainly · priced in PHP</p>
    </div>
    <h1 data-reveal class="mt-10 max-w-3xl" style="font-size: clamp(2.8rem, 7vw, 5.75rem); line-height: 0.98;">
      Three ways I can <em class="text-accent">help you ship.</em>
    </h1>
    <p data-reveal data-reveal-delay="80" class="mt-7 max-w-xl text-lg leading-relaxed text-stone">
      I help small teams ship faster with AI, data, and the web.
    </p>
  </section>

  <section class="container py-10 md:py-14">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-7" style="perspective: 1200px;">
      {services.map((s, i) => (
        <div data-reveal data-reveal-delay={i * 100} class="h-full">
          <TiltCard client:idle>
            <article class={`flex h-full flex-col border p-6 md:p-7 ${s.featured ? 'section-ink border-transparent' : 'border-line bg-raised'}`}>
              <div class="flex items-baseline justify-between gap-4 border-b border-line pb-4">
                <span class="font-display text-3xl text-gold" aria-hidden="true">{s.n}</span>
                <span class="meta-mono">{s.category}</span>
              </div>

              <h2 class="mt-6 text-2xl leading-tight md:text-[1.6rem]">{s.title}</h2>
              <p class="mt-3 text-sm leading-relaxed text-stone">{s.summary}</p>

              <p class="meta-mono mt-7">What's included</p>
              <ul class="mt-3 flex-1 space-y-2.5 text-sm">
                {s.bullets.map((b) => (
                  <li class="flex gap-2.5 leading-relaxed">
                    <span aria-hidden="true" class="mt-[0.48em] inline-block h-[5px] w-[5px] flex-none bg-gold"></span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-8 flex items-end justify-between gap-4 border-t border-line pt-5">
                <p>
                  <span class="meta-mono block">{s.priceNote}</span>
                  <span class="font-mono text-sm font-semibold text-accent">{s.price}</span>
                </p>
                <a
                  href="/contact"
                  data-cursor="hover"
                  class="inline-flex h-10 w-10 flex-none items-center justify-center border border-line-strong text-sm transition-all duration-200 hover:border-gold hover:bg-gold hover:text-ink"
                  aria-label={`Start a conversation about ${s.title}`}
                >
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          </TiltCard>
        </div>
      ))}
    </div>
  </section>

  <section class="container py-16 md:py-24">
    <div class="ledger-head" data-reveal>
      <p class="eyebrow">The process · Four steps</p>
      <p class="meta-mono hidden sm:block">Discover → Scope → Build → Hand off</p>
    </div>
    <h2 data-reveal class="mt-10 max-w-xl text-3xl md:text-4xl">How we'll work together</h2>
    <ol class="mt-12 grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s, i) => (
        <li data-reveal data-reveal-delay={i * 80} class="border-t-2 border-gold pt-5">
          <p class="font-display text-3xl text-accent" aria-hidden="true">0{s.n}</p>
          <h3 class="mt-3 text-xl">{s.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-stone">{s.text}</p>
        </li>
      ))}
    </ol>

    <div class="mt-16 flex flex-wrap items-center justify-between gap-6 border-t border-line pt-8" data-reveal>
      <p class="max-w-md text-sm leading-relaxed text-stone">
        Not sure which bucket your problem fits? Describe it plainly and I will scope it honestly — including telling you if you do not need me.
      </p>
      <a href="/contact" data-cursor="hover" data-magnetic class="button-primary">
        Start a conversation
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
