---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resumeData } from '../lib/resume-content';
import { socials } from '../lib/socials';

const { name, tagline, phone, email, location, website, linkedin, summary, skills, experience, projects, education, awards } =
  resumeData;
const socialLinks = socials.filter((s) => s.url);
const contactLine = [location, phone, email].join(' · ');
---

<BaseLayout
  title="CV — Uzziel Malolos"
  description="Curriculum vitae of Emmanuel Uzziel A. Malolos — full-stack creator, AI tool builder, and agri-econ researcher."
>
  <section class="container pt-24 pb-8 md:pt-32">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div>
        <p class="text-xs uppercase tracking-widest text-stone mb-3">CV / Resume</p>
        <h1 class="font-display leading-[1] tracking-tight" style="font-size: clamp(2.5rem, 6vw, 4.5rem);">
          {name}
        </h1>
        <p class="mt-3 text-sm text-stone max-w-2xl">{tagline}</p>
        <p class="mt-2 font-mono text-sm text-stone">{contactLine}</p>
        <p class="mt-1 font-mono text-sm text-stone">
          <a href={website} target="_blank" rel="noopener noreferrer" class="hover:text-gold transition-colors">
            {website.replace('https://', '')}
          </a>
          {' · '}
          <a href={linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-gold transition-colors">
            LinkedIn
          </a>
        </p>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <a
          href="/downloads/uzziel-malolos-resume.docx"
          download
          data-cursor="hover"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-gold text-gold font-medium text-sm hover:bg-gold/10 transition-colors"
        >
          Download DOCX
          <span aria-hidden="true">↓</span>
        </a>
        <a
          href="/contact"
          data-cursor="hover"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-gold text-ink font-medium text-sm hover:bg-gold/90 transition-colors"
        >
          Contact me
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="container py-10 max-w-3xl">
    <h2 class="font-display text-lg mb-4 text-narra dark:text-gold uppercase tracking-widest text-xs">Professional Summary</h2>
    <p class="text-stone leading-relaxed">{summary}</p>
  </section>

  <section class="container py-10 max-w-3xl border-t border-stone/20">
    <h2 class="font-display mb-6 text-narra dark:text-gold uppercase tracking-widest text-xs">Technical Skills</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5">
      {skills.map((s) => (
        <div>
          <p class="text-sm font-medium text-ink dark:text-cream mb-1.5">{s.group}</p>
          <div class="flex flex-wrap gap-1.5">
            {s.items.map((item) => (
              <span class="font-mono text-[11px] text-stone border border-stone/30 px-2 py-0.5 rounded">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="container py-10 max-w-3xl border-t border-stone/20">
    <h2 class="font-display mb-6 text-narra dark:text-gold uppercase tracking-widest text-xs">Experience</h2>
    <div class="space-y-10">
      {experience.map((e) => (
        <div>
          <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1 mb-2">
            <p class="font-display text-lg">{e.role}</p>
            <p class="font-mono text-xs text-stone whitespace-nowrap">{e.org} · {e.period}</p>
          </div>
          <ul class="space-y-1.5">
            {e.bullets.map((b) => (
              <li class="text-sm text-stone leading-relaxed pl-4 relative before:absolute before:left-0 before:top-[0.6em] before:w-1 before:h-1 before:rounded-full before:bg-stone/50">{b}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="container py-10 max-w-3xl border-t border-stone/20">
    <h2 class="font-display mb-6 text-narra dark:text-gold uppercase tracking-widest text-xs">Selected Projects (2026)</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {projects.map((p) => (
        <div class="rounded-lg border border-stone/20 bg-cream/50 dark:bg-ink/40 p-4">
          <p class="font-display text-sm font-medium">{p.title}</p>
          <p class="mt-1.5 text-xs text-stone leading-relaxed">{p.summary}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container py-10 max-w-3xl border-t border-stone/20">
    <h2 class="font-display mb-6 text-narra dark:text-gold uppercase tracking-widest text-xs">Education</h2>
    <div class="space-y-6">
      {education.map((e) => (
        <div>
          <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1">
            <p class="font-display text-lg">{e.degree}</p>
            <p class="font-mono text-xs text-stone whitespace-nowrap">{e.year}</p>
          </div>
          <p class="text-sm text-stone mt-0.5">{e.school}</p>
          <p class="text-xs text-stone mt-0.5">{e.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container py-10 max-w-3xl border-t border-stone/20">
    <h2 class="font-display mb-6 text-narra dark:text-gold uppercase tracking-widest text-xs">Awards & Achievements</h2>
    <ul class="space-y-2">
      {awards.map((a) => (
        <li class="text-sm text-stone leading-relaxed pl-4 relative before:absolute before:left-0 before:top-[0.5em] before:w-1 before:h-1 before:rounded-full before:bg-gold">{a}</li>
      ))}
    </ul>
  </section>

  <section class="container py-16 max-w-3xl border-t border-stone/20">
    <div class="rounded-lg border border-stone/20 bg-ink text-cream dark:bg-cream dark:text-ink px-6 py-8 md:px-10 md:py-10">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <p class="font-display text-2xl leading-tight">Prefer a downloadable copy?</p>
          <p class="mt-2 text-sm text-cream/75 dark:text-ink/70">
            Grab the Word version for applications, or email me for a tailored PDF.
          </p>
        </div>
        <a
          href="/downloads/uzziel-malolos-resume.docx"
          download
          data-cursor="hover"
          class="inline-flex items-center gap-2 shrink-0 px-5 py-3 rounded-full bg-gold text-ink font-medium text-sm hover:bg-gold/90 transition-colors"
        >
          Download resume
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-stone">
      {socialLinks.map((s) => (
        <a href={s.url} target="_blank" rel="noopener noreferrer" class="hover:text-gold transition-colors">
          {s.platform} ↗
        </a>
      ))}
      <span class="text-stone">·</span>
      <a href="mailto:uzzielmalolos@gmail.com" class="hover:text-gold transition-colors">uzzielmalolos@gmail.com</a>
    </div>
  </section>
</BaseLayout>
