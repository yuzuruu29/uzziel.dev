---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resumeData } from '../lib/resume-content';
import { socials } from '../lib/socials';

const { name, tagline, phone, email, location, website, linkedin, summary, skills, experience, projects, education, awards } =
  resumeData;
const socialLinks = socials.filter((s) => s.url);
---

<BaseLayout
  title="CV — Uzziel Malolos"
  description="Curriculum vitae of Emmanuel Uzziel A. Malolos — full-stack creator, AI tool builder, and ACEU AI Solutions co-founder."
>
  <section class="container pb-10 pt-12 md:pt-16">
    <div class="ledger-head" data-reveal>
      <p class="eyebrow">CV · Resume</p>
      <p class="meta-mono hidden sm:block">Remote-ready — GMT+8</p>
    </div>

    <div class="grid gap-10 pt-10 lg:grid-cols-[1fr_auto] lg:items-end">
      <div data-reveal>
        <h1 style="font-size: clamp(2.5rem, 5.5vw, 4.5rem); line-height: 1;">{name}</h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-stone">{tagline}</p>
        <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 font-mono text-[11px] uppercase tracking-[0.1em] text-stone">
          <li>{location}</li>
          <li>{phone}</li>
          <li>{email}</li>
          <li>
            <a href={website} target="_blank" rel="noopener noreferrer" class="link-line transition-colors hover:text-accent">
              {website.replace('https://', '')}
            </a>
          </li>
          <li>
            <a href={linkedin} target="_blank" rel="noopener noreferrer" class="link-line transition-colors hover:text-accent">
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
      <div class="flex flex-wrap gap-3" data-reveal data-reveal-delay="100">
        <a href="/downloads/uzziel-malolos-resume.docx" download data-cursor="hover" class="button-secondary">
          Download DOCX
          <span aria-hidden="true">↓</span>
        </a>
        <a href="/contact" data-cursor="hover" class="button-primary">
          Contact me
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="container max-w-4xl py-10">
    <div class="ledger-head">
      <p class="eyebrow">01 · Professional summary</p>
    </div>
    <p class="pt-8 text-lg leading-relaxed text-stone">{summary}</p>
  </section>

  <section class="container max-w-4xl py-10">
    <div class="ledger-head">
      <p class="eyebrow">02 · Technical skills</p>
    </div>
    <dl class="pt-8">
      {skills.map((s) => (
        <div class="grid gap-2 border-b border-line py-4 first:border-t md:grid-cols-[220px_1fr] md:gap-8">
          <dt class="text-sm font-medium">{s.group}</dt>
          <dd class="font-mono text-[11px] uppercase leading-[1.9] tracking-[0.06em] text-stone">
            {s.items.join(' · ')}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="container max-w-4xl py-10">
    <div class="ledger-head">
      <p class="eyebrow">03 · Experience</p>
    </div>
    <div class="space-y-12 pt-8">
      {experience.map((e, i) => (
        <div class="grid gap-4 md:grid-cols-[2.5rem_1fr]">
          <span class="font-display text-2xl text-gold" aria-hidden="true">0{i + 1}</span>
          <div>
            <div class="flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between">
              <h2 class="text-xl md:text-2xl">{e.role}</h2>
              <p class="meta-mono whitespace-nowrap">{e.org} · {e.period}</p>
            </div>
            <ul class="mt-4 space-y-2">
              {e.bullets.map((b) => (
                <li class="relative pl-5 text-sm leading-relaxed text-stone before:absolute before:left-0 before:top-[0.55em] before:h-[5px] before:w-[5px] before:bg-gold/70">{b}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="container max-w-4xl py-10">
    <div class="ledger-head">
      <p class="eyebrow">04 · Selected projects (2026)</p>
    </div>
    <div class="pt-8">
      {projects.map((p, i) => (
        <div class="grid grid-cols-[2.5rem_1fr] items-baseline gap-4 border-b border-line py-4 first:border-t md:grid-cols-[2.5rem_220px_1fr] md:gap-6">
          <span class="font-mono text-[11px] text-gold" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="text-base font-medium leading-snug" style="font-family: 'Inter Tight', sans-serif;">{p.title}</h3>
          <p class="col-span-2 mt-1 text-xs leading-relaxed text-stone md:col-span-1 md:mt-0 md:text-sm">{p.summary}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container max-w-4xl py-10">
    <div class="ledger-head">
      <p class="eyebrow">05 · Education</p>
    </div>
    <div class="space-y-8 pt-8">
      {education.map((e) => (
        <div>
          <div class="flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between">
            <h2 class="text-xl">{e.degree}</h2>
            <p class="meta-mono whitespace-nowrap">{e.year}</p>
          </div>
          <p class="mt-1 text-sm text-stone">{e.school}</p>
          <p class="mt-0.5 text-xs text-stone">{e.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container max-w-4xl py-10">
    <div class="ledger-head">
      <p class="eyebrow">06 · Awards & achievements</p>
    </div>
    <ul class="space-y-3 pt-8">
      {awards.map((a) => (
        <li class="relative pl-5 text-sm leading-relaxed text-stone before:absolute before:left-0 before:top-[0.5em] before:h-[5px] before:w-[5px] before:bg-gold">{a}</li>
      ))}
    </ul>
  </section>

  <section class="container max-w-4xl py-16">
    <div class="section-ink relative overflow-hidden px-6 py-10 md:px-10 md:py-12" data-reveal>
      <div class="ledger-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
      <div class="relative flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="meta-mono text-gold">Downloadable copy</p>
          <p class="mt-3 font-display text-3xl leading-tight text-cream">Prefer a file for the pile?</p>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-cream/70">
            Grab the Word version for applications, or email me for a tailored PDF.
          </p>
        </div>
        <a href="/downloads/uzziel-malolos-resume.docx" download data-cursor="hover" data-magnetic class="button-primary flex-none">
          Download resume
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[11px] uppercase tracking-[0.1em] text-stone">
      {socialLinks.map((s) => (
        <a href={s.url} target="_blank" rel="noopener noreferrer" class="link-line transition-colors hover:text-accent">
          {s.platform} ↗
        </a>
      ))}
      <a href="mailto:uzzielmalolos@gmail.com" class="link-line transition-colors hover:text-accent">uzzielmalolos@gmail.com</a>
    </div>
  </section>
</BaseLayout>
