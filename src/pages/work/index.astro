---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import WorkFilter from '../../islands/WorkFilter.tsx';

const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const sampleSlugs = new Set([
  'willow-creek-farmstay',
  'clearpath-lawn-care',
  'harvest-table-kitchen',
  'ai-book-content-portfolio',
  'ai-youtube-thumbnail-design-portfolio',
]);
const projectEntries = entries.filter((entry) => !sampleSlugs.has(entry.slug));
const sampleEntries = entries.filter((entry) => sampleSlugs.has(entry.slug));
const activeCount = projectEntries.filter((entry) => entry.data.status === 'in-progress').length;
const shippedCount = projectEntries.filter((entry) => ['live', 'completed'].includes(entry.data.status)).length;
const buildingNow = projectEntries
  .filter((entry) => entry.data.status === 'in-progress')
  .map((entry) => ({ slug: entry.slug, title: entry.data.title }));

const stats = [
  { label: 'Projects', value: projectEntries.length },
  { label: 'In progress', value: activeCount },
  { label: 'Live + complete', value: shippedCount },
];
const filterProjects = projectEntries.map(({ data }) => ({ stack: data.stack, status: data.status }));
---

<BaseLayout
  title="Work — Uzziel Malolos"
  description="Apps, indie games, websites, and AI systems designed and built by Uzziel Malolos, a Filipino full-stack creator."
>
  <section class="container pb-10 pt-12 md:pb-12 md:pt-20">
    <div class="ledger-head" data-reveal>
      <p class="eyebrow">The collection · All work</p>
      <p class="meta-mono hidden sm:block">Apps · Games · Websites · Systems</p>
    </div>

    <div class="grid gap-10 pt-10 md:pt-14 lg:grid-cols-[1fr_240px] lg:items-end lg:gap-20">
      <div data-reveal>
        <h1 class="max-w-4xl text-[clamp(3.25rem,7vw,6rem)] leading-[0.95] tracking-[-0.03em]">
          Useful things.<br />
          <em class="text-accent">Playful worlds.</em>
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-stone md:text-xl">
          Apps for everyday problems, games to get lost in, and websites and systems that help people get things done. Here’s what I’ve been building.
        </p>
      </div>

      <dl class="grid grid-cols-3 divide-x divide-[color:var(--border)] border-y border-line py-5 lg:grid-cols-1 lg:divide-x-0 lg:divide-y lg:border-y-0 lg:border-l lg:py-0 lg:pl-8" data-reveal data-reveal-delay="100">
        {stats.map((stat) => (
          <div class="px-3 first:pl-0 lg:px-0 lg:py-4 lg:first:pt-0 lg:last:pb-0">
            <dd class="font-display text-4xl tracking-[-0.04em] md:text-5xl">{String(stat.value).padStart(2, '0')}</dd>
            <dt class="meta-mono mt-1 leading-relaxed">{stat.label}</dt>
          </div>
        ))}
      </dl>
    </div>

    {buildingNow.length > 0 && (
      <div class="mt-10 flex flex-wrap items-baseline gap-x-4 gap-y-2 border-t border-line pt-6" data-reveal data-reveal-delay="160">
        <span class="meta-mono flex items-center gap-2 text-accent">
          <span class="inline-block h-1.5 w-1.5 bg-gold" aria-hidden="true"></span>
          On the workbench · {buildingNow.length}
        </span>
        <ul class="flex flex-wrap items-baseline gap-x-2 gap-y-1.5 text-sm" aria-label="In-progress projects">
          {buildingNow.map((entry, i) => (
            <li class="inline-flex items-baseline gap-2">
              <a
                href={`/work/${entry.slug}`}
                data-cursor="hover"
                class="font-mono text-[12px] text-ink underline decoration-gold/40 decoration-1 underline-offset-[3px] transition-colors hover:decoration-gold dark:text-cream"
              >
                {entry.title}
              </a>
              {i < buildingNow.length - 1 && (
                <span class="text-stone" aria-hidden="true">·</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="mt-10 border-t border-line pt-6 md:mt-12">
      <WorkFilter client:load gridId="project-work-grid" projects={filterProjects} />
    </div>
  </section>

  <section class="container pb-24">
    <WorkGrid entries={projectEntries} id="project-work-grid" />
  </section>

  <!-- Concept samples — separated on an ink band so they never read as client claims -->
  <section id="sample-portfolios" class="relative">
    <div class="dither-up dither-ink" aria-hidden="true"></div>
    <div class="section-ink relative overflow-hidden">
      <div class="ledger-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
      <div class="container relative py-16 md:py-20">
        <div class="ledger-head" data-reveal>
          <p class="eyebrow">The sketchbook · {sampleEntries.length} samples</p>
          <p class="meta-mono hidden sm:block">Room to try things</p>
        </div>

        <div class="grid gap-6 pb-12 pt-10 md:grid-cols-[1fr_320px] md:items-end">
          <h2 class="max-w-2xl text-cream" data-reveal>
            A few ideas<br />taken for a spin.
          </h2>
          <p class="text-sm leading-relaxed text-cream/65 md:justify-self-end" data-reveal data-reveal-delay="100">
            Landing pages for fictional businesses and AI-assisted design samples. Self-directed concepts, made to explore a brief.
          </p>
        </div>

        <WorkGrid entries={sampleEntries} id="sample-work-grid" />
      </div>
    </div>
    <div class="dither-down dither-ink" aria-hidden="true"></div>
  </section>
</BaseLayout>
