---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, i) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      prev: i > 0 ? entries[i - 1] : null,
      next: i < entries.length - 1 ? entries[i + 1] : null,
      position: i + 1,
      total: entries.length,
    },
  }));
}

type Props = {
  entry: CollectionEntry<'work'>;
  prev: CollectionEntry<'work'> | null;
  next: CollectionEntry<'work'> | null;
  position: number;
  total: number;
};

const { entry, prev, next, position, total } = Astro.props as Props;
const { Content } = await entry.render();
const { data } = entry;
const slug = entry.slug;

const creativeWorkJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.summary,
  author: {
    '@type': 'Person',
    name: 'Emmanuel Uzziel A. Malolos',
    url: 'https://uzziel.dev/about',
  },
  dateCreated: String(data.year),
  url: `https://uzziel.dev/work/${slug}`,
  creativeWorkStatus: data.status,
  keywords: data.stack.join(', '),
});

const statusClasses: Record<typeof data.status, string> = {
  live: 'bg-leaf text-cream',
  completed: 'bg-gold text-ink',
  'in-progress': 'bg-gold text-ink',
  archived: 'bg-stone text-cream',
};
const statusLabel: Record<typeof data.status, string> = {
  live: 'Live',
  completed: 'Completed',
  'in-progress': 'In progress',
  archived: 'Archived',
};

const indexLabel = `${String(position).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
---

<BaseLayout title={`${data.title} — Uzziel Malolos`} description={data.summary} jsonLd={creativeWorkJsonLd}>
  <div id="read-progress" class="fixed left-0 top-0 z-50 h-[3px] w-full origin-left bg-gold" aria-hidden="true" style="transform: scaleX(0);"></div>

  <section
    id="case-cover"
    class="relative flex min-h-[540px] w-full items-end overflow-hidden md:h-[70vh] md:max-h-[780px]"
  >
    <img
      id="case-cover-img"
      src={data.cover}
      alt={`${data.title} cover`}
      width="1600"
      height="900"
      transition:name={`cover-${slug}`}
      class="absolute inset-0 h-full w-full object-cover will-change-transform"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/40 to-ink/25" aria-hidden="true"></div>

    <div class="container relative pb-16 pt-28 md:pb-20">
      <div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[10px] uppercase tracking-[0.16em] text-cream/70">
        <a href="/work" data-cursor="hover" class="link-line text-cream/70 transition-colors hover:text-gold">← Work</a>
        <span aria-hidden="true" class="text-cream/40">/</span>
        <span>{indexLabel}</span>
        <span class={`inline-flex w-fit items-center px-2.5 py-1 tracking-[0.14em] ${statusClasses[data.status]}`}>
          {statusLabel[data.status]}
        </span>
        <span>{data.year}</span>
        <span aria-hidden="true" class="text-cream/40">·</span>
        <span>{data.role}</span>
      </div>
      <h1 class="max-w-4xl text-cream" style="font-size: clamp(2.6rem, 6.5vw, 5.5rem); line-height: 1;">
        {data.title}
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-cream/80 md:text-lg">{data.summary}</p>
    </div>

    <!-- Cover dissolves into the page -->
    <div class="dither-up dither-page absolute inset-x-0 bottom-0" aria-hidden="true"></div>
  </section>

  <section class="container grid grid-cols-1 gap-12 py-14 md:grid-cols-[minmax(0,1fr)_300px] md:gap-16 md:py-24">
    <article class="prose-case font-sans text-ink dark:text-cream">
      <Content />
    </article>

    <aside class="h-fit border-t-2 border-gold pt-6 text-sm md:sticky md:top-24" data-reveal data-reveal-delay="120">
      <p class="meta-mono text-accent">Project record</p>
      <dl>
        <div class="flex items-baseline justify-between gap-6 border-b border-line py-4">
          <dt class="meta-mono">Status</dt>
          <dd class="flex items-center gap-2 text-right">
            <span class={`inline-block h-1.5 w-1.5 ${data.status === 'live' ? 'bg-leaf' : data.status === 'archived' ? 'bg-stone' : 'bg-gold'}`} aria-hidden="true"></span>
            {statusLabel[data.status]}
          </dd>
        </div>
        <div class="flex items-baseline justify-between gap-6 border-b border-line py-4">
          <dt class="meta-mono">Year</dt>
          <dd class="font-mono text-[13px]">{data.year}</dd>
        </div>
        <div class="flex items-baseline justify-between gap-6 border-b border-line py-4">
          <dt class="meta-mono">Role</dt>
          <dd class="max-w-[16ch] text-right leading-snug">{data.role}</dd>
        </div>
        <div class="border-b border-line py-4">
          <dt class="meta-mono">Stack</dt>
          <dd class="mt-3">
            <ul class="space-y-1.5">
              {data.stack.map((s) => (
                <li class="flex items-baseline gap-2.5 font-mono text-[11px] uppercase tracking-[0.08em] text-stone">
                  <span class="inline-block h-1 w-1 flex-none bg-gold/70" aria-hidden="true"></span>
                  {s}
                </li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>
      <a href="/work" data-cursor="hover" class="link-line mt-5 inline-block font-mono text-[11px] uppercase tracking-[0.14em] text-accent">
        All projects →
      </a>
    </aside>
  </section>

  <nav class="container border-t border-line pb-24 pt-4" aria-label="Case study pagination" data-reveal>
    <div class="grid grid-cols-1 md:grid-cols-2 md:divide-x md:divide-[color:var(--border)]">
      <div class="min-h-24 py-6 md:pr-10">
        {prev && (
          <a href={`/work/${prev.slug}`} data-cursor="hover" class="group block">
            <p class="meta-mono flex items-center gap-2">
              <span aria-hidden="true" class="inline-block transition-transform duration-200 group-hover:-translate-x-1">←</span>
              Previous
            </p>
            <p class="mt-3 font-display text-2xl leading-tight transition-colors group-hover:text-accent md:text-3xl">{prev.data.title}</p>
          </a>
        )}
      </div>
      <div class="min-h-24 border-t border-line py-6 md:border-t-0 md:pl-10 md:text-right">
        {next && (
          <a href={`/work/${next.slug}`} data-cursor="hover" class="group block">
            <p class="meta-mono flex items-center gap-2 md:justify-end">
              Next
              <span aria-hidden="true" class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
            </p>
            <p class="mt-3 font-display text-2xl leading-tight transition-colors group-hover:text-accent md:text-3xl">{next.data.title}</p>
          </a>
        )}
      </div>
    </div>
  </nav>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const img = document.getElementById('case-cover-img');
    const cover = document.getElementById('case-cover');
    if (img && cover && !reduced) {
      const tween = gsap.to(img, {
        scale: 1.08,
        ease: 'none',
        scrollTrigger: {
          trigger: cover,
          start: 'top top',
          end: 'bottom top',
          scrub: 0.5,
        },
      });
      document.addEventListener('astro:before-swap', () => {
        tween.scrollTrigger?.kill();
        tween.kill();
      }, { once: true });
    }

    const progress = document.getElementById('read-progress');
    const article = document.querySelector<HTMLElement>('article.prose-case');
    if (progress && article && !reduced) {
      gsap.to(progress, {
        scaleX: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: article,
          start: 'top 10%',
          end: 'bottom 80%',
          scrub: 0.3,
        },
      });
    }
  </script>
</BaseLayout>
