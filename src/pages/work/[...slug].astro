---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, i) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      prev: i > 0 ? entries[i - 1] : null,
      next: i < entries.length - 1 ? entries[i + 1] : null,
    },
  }));
}

type Props = {
  entry: CollectionEntry<'work'>;
  prev: CollectionEntry<'work'> | null;
  next: CollectionEntry<'work'> | null;
};

const { entry, prev, next } = Astro.props as Props;
const { Content } = await entry.render();
const { data } = entry;
const slug = entry.slug;

const creativeWorkJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.summary,
  author: {
    '@type': 'Person',
    name: 'Emmanuel Uzziel A. Malolos',
    url: 'https://uzziel.dev/about',
  },
  dateCreated: String(data.year),
  url: `https://uzziel.dev/work/${slug}`,
  creativeWorkStatus: data.status,
  keywords: data.stack.join(', '),
});

const statusClasses: Record<typeof data.status, string> = {
  'live': 'bg-leaf/15 text-leaf',
  'in-progress': 'bg-gold/15 text-narra',
  'archived': 'bg-stone/15 text-stone',
};
const statusLabel: Record<typeof data.status, string> = {
  'live': 'Live',
  'in-progress': 'In progress',
  'archived': 'Archived',
};
---

<BaseLayout title={`${data.title} — Uzziel Malolos`} description={data.summary} jsonLd={creativeWorkJsonLd}>
  <section
    id="case-cover"
    class="relative w-full overflow-hidden"
    style="height: 60vh;"
  >
    <img
      id="case-cover-img"
      src={data.cover}
      alt={`${data.title} cover`}
      width="1600"
      height="900"
      transition:name={`cover-${slug}`}
      class="absolute inset-0 w-full h-full object-cover will-change-transform"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-cream dark:to-ink"></div>
    <div class="container relative h-full flex flex-col justify-end pb-10">
      <span class={`inline-flex w-fit items-center text-[11px] font-medium uppercase tracking-wider px-2 py-0.5 rounded-full ${statusClasses[data.status]}`}>
        {statusLabel[data.status]}
      </span>
      <h1 class="mt-4 font-display text-cream leading-[1] tracking-tight" style="font-size: clamp(2.5rem, 6vw, 5rem);">
        {data.title}
      </h1>
    </div>
  </section>

  <section class="container grid grid-cols-1 md:grid-cols-[1fr_280px] gap-12 md:gap-16 py-16 md:py-24">
    <article class="prose-case max-w-prose font-sans text-ink dark:text-cream">
      <Content />
    </article>

    <aside class="md:sticky md:top-24 h-fit text-sm">
      <dl class="space-y-5">
        <div>
          <dt class="text-[11px] uppercase tracking-widest text-stone">Role</dt>
          <dd class="mt-1">{data.role}</dd>
        </div>
        <div>
          <dt class="text-[11px] uppercase tracking-widest text-stone">Year</dt>
          <dd class="mt-1 font-mono">{data.year}</dd>
        </div>
        <div>
          <dt class="text-[11px] uppercase tracking-widest text-stone">Stack</dt>
          <dd class="mt-2">
            <ul class="flex flex-wrap gap-1.5">
              {data.stack.map((s) => (
                <li class="font-mono text-[11px] text-stone border border-stone/30 px-2 py-0.5 rounded">{s}</li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>
    </aside>
  </section>

  <nav class="container pb-24 grid grid-cols-1 md:grid-cols-2 gap-6 border-t border-stone/20 pt-10" aria-label="Case study pagination">
    <div>
      {prev && (
        <a href={`/work/${prev.slug}`} data-cursor="hover" class="group block">
          <p class="text-[11px] uppercase tracking-widest text-stone">← Previous</p>
          <p class="mt-2 font-display text-xl group-hover:text-gold transition-colors">{prev.data.title}</p>
        </a>
      )}
    </div>
    <div class="md:text-right">
      {next && (
        <a href={`/work/${next.slug}`} data-cursor="hover" class="group block">
          <p class="text-[11px] uppercase tracking-widest text-stone">Next →</p>
          <p class="mt-2 font-display text-xl group-hover:text-gold transition-colors">{next.data.title}</p>
        </a>
      )}
    </div>
  </nav>

  <style is:global>
    .prose-case p { margin-bottom: 1.25rem; line-height: 1.75; }
    .prose-case p:first-of-type::first-line { font-weight: 500; }
    .prose-case h2 { font-family: 'Fraunces', Georgia, serif; font-size: 1.75rem; margin: 2.5rem 0 1rem; }
    .prose-case a { color: #c9a14a; text-decoration: underline; text-underline-offset: 3px; }
    .prose-case strong { color: inherit; font-weight: 600; }
    .prose-case img {
      width: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      border-radius: 0.5rem;
      border: 1px solid rgb(138 125 110 / 0.3);
      margin: 2rem 0 0.65rem;
      background: rgb(26 20 16 / 0.08);
    }
    .prose-case .case-figure {
      margin: 2rem 0 0.65rem;
    }
    .prose-case .case-figure img {
      margin: 0;
    }
    .prose-case .case-figure figcaption {
      margin-top: 0.5rem;
      color: #8a7d6e;
      font-size: 0.8125rem;
      line-height: 1.5;
    }
    .prose-case p:has(> img) {
      margin: 2rem 0 0.65rem;
    }
    .prose-case p:has(> img) + p,
    .prose-case .case-figure + p {
      margin-top: 0;
    }
  </style>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const img = document.getElementById('case-cover-img');
    const cover = document.getElementById('case-cover');
    if (img && cover && !reduced) {
      gsap.to(img, {
        scale: 1.15,
        ease: 'none',
        scrollTrigger: {
          trigger: cover,
          start: 'top top',
          end: 'bottom top',
          scrub: 0.5,
        },
      });
    }
  </script>
</BaseLayout>
