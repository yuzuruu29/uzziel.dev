---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, i) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      prev: i > 0 ? entries[i - 1] : null,
      next: i < entries.length - 1 ? entries[i + 1] : null,
    },
  }));
}

type Props = {
  entry: CollectionEntry<'work'>;
  prev: CollectionEntry<'work'> | null;
  next: CollectionEntry<'work'> | null;
};

const { entry, prev, next } = Astro.props as Props;
const { Content } = await entry.render();
const { data } = entry;
const slug = entry.slug;

const creativeWorkJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.summary,
  author: {
    '@type': 'Person',
    name: 'Emmanuel Uzziel A. Malolos',
    url: 'https://uzziel.dev/about',
  },
  dateCreated: String(data.year),
  url: `https://uzziel.dev/work/${slug}`,
  creativeWorkStatus: data.status,
  keywords: data.stack.join(', '),
});

const statusClasses: Record<typeof data.status, string> = {
  live: 'bg-leaf text-cream',
  completed: 'bg-gold text-ink',
  'in-progress': 'bg-gold text-ink',
  archived: 'bg-stone text-cream',
};
const statusLabel: Record<typeof data.status, string> = {
  live: 'Live',
  completed: 'Completed',
  'in-progress': 'In progress',
  archived: 'Archived',
};
---

<BaseLayout title={`${data.title} — Uzziel Malolos`} description={data.summary} jsonLd={creativeWorkJsonLd}>
  <div id="read-progress" class="fixed left-0 top-0 z-50 h-0.5 origin-left bg-gold" aria-hidden="true" style="scaleX(0)"></div>

  <section
    id="case-cover"
    class="relative flex min-h-[520px] w-full items-end overflow-hidden md:h-[68vh] md:max-h-[760px]"
  >
    <img
      id="case-cover-img"
      src={data.cover}
      alt={`${data.title} cover`}
      width="1600"
      height="900"
      transition:name={`cover-${slug}`}
      class="absolute inset-0 h-full w-full object-cover will-change-transform"
    />
    <div class="absolute inset-0 bg-ink/60"></div>
    <div class="container relative pb-10 pt-28 md:pb-14">
      <div class="mb-5 flex flex-wrap items-center gap-3 font-mono text-[10px] uppercase tracking-[0.15em] text-cream/65">
        <span class={`inline-flex w-fit items-center rounded-md px-2.5 py-1 ${statusClasses[data.status]}`}>
        {statusLabel[data.status]}
        </span>
        <span>{data.year}</span>
        <span aria-hidden="true">·</span>
        <span>{data.role}</span>
      </div>
      <h1 class="max-w-4xl text-cream">
        {data.title}
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-cream/75 md:text-lg">{data.summary}</p>
    </div>
  </section>

  <section class="container grid grid-cols-1 gap-12 py-16 md:grid-cols-[minmax(0,1fr)_300px] md:gap-16 md:py-24">
    <article class="prose-case font-sans text-ink dark:text-cream">
      <Content />
    </article>

    <aside class="card-surface h-fit rounded-xl p-6 text-sm md:sticky md:top-24" data-reveal data-reveal-delay="120">
      <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-stone">Project record</p>
      <dl class="space-y-5">
        <div class="mt-5 border-t border-stone/20 pt-5">
          <dt class="text-[11px] uppercase tracking-widest text-stone">Role</dt>
          <dd class="mt-1">{data.role}</dd>
        </div>
        <div>
          <dt class="text-[11px] uppercase tracking-widest text-stone">Year</dt>
          <dd class="mt-1 font-mono">{data.year}</dd>
        </div>
        <div>
          <dt class="text-[11px] uppercase tracking-widest text-stone">Stack</dt>
          <dd class="mt-2">
            <ul class="flex flex-wrap gap-1.5">
              {data.stack.map((s) => (
                <li class="font-mono text-[11px] text-stone border border-stone/30 px-2 py-0.5 rounded">{s}</li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>
    </aside>
  </section>

  <nav class="container grid grid-cols-1 gap-5 border-t border-stone/20 pb-24 pt-10 md:grid-cols-2" aria-label="Case study pagination" data-reveal>
    <div class="min-h-20">
      {prev && (
        <a href={`/work/${prev.slug}`} data-cursor="hover" class="group block rounded-lg border border-transparent p-3 transition-colors hover:border-stone/25">
          <p class="text-[11px] uppercase tracking-widest text-stone">← Previous</p>
          <p class="mt-2 font-display text-xl group-hover:text-gold transition-colors">{prev.data.title}</p>
        </a>
      )}
    </div>
    <div class="min-h-20 md:text-right">
      {next && (
        <a href={`/work/${next.slug}`} data-cursor="hover" class="group block rounded-lg border border-transparent p-3 transition-colors hover:border-stone/25">
          <p class="text-[11px] uppercase tracking-widest text-stone">Next →</p>
          <p class="mt-2 font-display text-xl group-hover:text-gold transition-colors">{next.data.title}</p>
        </a>
      )}
    </div>
  </nav>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const img = document.getElementById('case-cover-img');
    const cover = document.getElementById('case-cover');
    if (img && cover && !reduced) {
      const tween = gsap.to(img, {
        scale: 1.08,
        ease: 'none',
        scrollTrigger: {
          trigger: cover,
          start: 'top top',
          end: 'bottom top',
          scrub: 0.5,
        },
      });
      document.addEventListener('astro:before-swap', () => {
        tween.scrollTrigger?.kill();
        tween.kill();
      }, { once: true });
    }

    const progress = document.getElementById('read-progress');
    const article = document.querySelector<HTMLElement>('article.prose-case');
    if (progress && article && !reduced) {
      gsap.to(progress, {
        scaleX: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: article,
          start: 'top 10%',
          end: 'bottom 80%',
          scrub: 0.3,
        },
      });
    }
  </script>
</BaseLayout>
