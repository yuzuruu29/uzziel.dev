---
import BaseLayout from '../layouts/BaseLayout.astro';
import Magnetic from '../islands/Magnetic.tsx';
import { socials } from '../lib/socials';

const inputClass =
  'w-full border-0 border-b border-[color:var(--line-strong)] bg-transparent px-0 py-3 text-base outline-none transition-colors focus:border-[color:var(--accent)]';
---

<BaseLayout
  title="Contact — Uzziel Malolos"
  description="Send a message. I reply within 2 business days, GMT+8."
>
  <section class="container pb-14 pt-12 md:pt-16">
    <div class="ledger-head" data-reveal>
      <p class="eyebrow">Contact · Open channel</p>
      <p class="meta-mono hidden sm:block">Replies within 2 business days — GMT+8</p>
    </div>
    <h1 data-reveal class="mt-10" style="font-size: clamp(2.8rem, 7.5vw, 6rem); line-height: 0.98;">
      Let's <em class="text-accent">talk.</em>
    </h1>
    <p data-reveal data-reveal-delay="80" class="mt-7 max-w-xl text-lg leading-relaxed text-stone">
      Project inquiries, product collaborations, or just to say hi. Choose the option that fits and I'll write back.
    </p>
  </section>

  <section class="container grid grid-cols-1 gap-14 py-10 md:grid-cols-[3fr_2fr] md:gap-16">
    <div id="contact-form-wrap">
      <form
        id="contact-form"
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/contact?success=true"
        class="space-y-8"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don't fill: <input name="bot-field" /></label>
        </p>

        <div data-reveal>
          <label for="name" class="meta-mono mb-1 block">01 — Name *</label>
          <input id="name" name="name" type="text" required autocomplete="name" class={inputClass} />
        </div>

        <div data-reveal data-reveal-delay="60">
          <label for="email" class="meta-mono mb-1 block">02 — Email *</label>
          <input id="email" name="email" type="email" required autocomplete="email" class={inputClass} />
        </div>

        <div data-reveal data-reveal-delay="120" class="grid grid-cols-1 gap-8 md:grid-cols-2">
          <div>
            <label for="project-type" class="meta-mono mb-1 block">03 — Project type</label>
            <select id="project-type" name="project-type" class={`${inputClass} bg-cream dark:bg-ink`}>
              <option value="Data">Data</option>
              <option value="Web">Web</option>
              <option value="AI">AI</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div>
            <label for="budget" class="meta-mono mb-1 block">04 — Budget</label>
            <select id="budget" name="budget" class={`${inputClass} bg-cream dark:bg-ink`}>
              <option value="Under PHP 10k">Under PHP 10k</option>
              <option value="PHP 10–30k">PHP 10–30k</option>
              <option value="PHP 30–60k">PHP 30–60k</option>
              <option value="PHP 60k+">PHP 60k+</option>
            </select>
          </div>
        </div>

        <div data-reveal data-reveal-delay="180">
          <label for="message" class="meta-mono mb-1 block">05 — Message *</label>
          <textarea id="message" name="message" required rows="6" class={`${inputClass} resize-y`}></textarea>
        </div>

        <div data-reveal data-reveal-delay="240">
          <Magnetic client:load>
            <button type="submit" data-cursor="hover" class="button-primary">
              Send message
              <span aria-hidden="true">→</span>
            </button>
          </Magnetic>
        </div>
      </form>
    </div>

    <aside id="thank-you-panel" class="hidden" aria-live="polite">
      <div class="border-t-2 border-leaf bg-surface p-7">
        <p class="meta-mono flex items-center gap-2">
          <span class="inline-block h-1.5 w-1.5 bg-leaf" aria-hidden="true"></span>
          Message received
        </p>
        <h2 class="mt-4 text-2xl">Thanks — it's in the ledger.</h2>
        <p class="mt-3 text-sm leading-relaxed text-stone">
          I'll get back to you within 2 business days. While you wait, see <a href="/work/tirador" class="link-line text-accent">TIRADOR →</a>
        </p>
      </div>
    </aside>

    <aside>
      <dl>
        <div class="border-b border-line py-5 first:border-t" data-reveal>
          <dt class="meta-mono">Response time</dt>
          <dd class="mt-2 text-sm leading-relaxed">Within 2 business days, GMT+8.</dd>
        </div>
        <div class="border-b border-line py-5" data-reveal data-reveal-delay="80">
          <dt class="meta-mono">Location</dt>
          <dd class="mt-2 text-sm leading-relaxed">Bay, Laguna, Philippines — 14.18°N, 121.28°E.</dd>
        </div>
        <div class="border-b border-line py-5" data-reveal data-reveal-delay="120">
          <dt class="meta-mono">Message delivery</dt>
          <dd class="mt-2 text-sm leading-relaxed text-stone">
            This form is handled by Netlify Forms. After deployment, submissions appear in the Netlify dashboard under <span class="font-medium text-ink dark:text-cream">Forms → contact</span>; email alerts are enabled from Netlify's form notifications.
          </dd>
        </div>
        <div class="py-5" data-reveal data-reveal-delay="160">
          <dt class="meta-mono mb-3">Elsewhere</dt>
          <dd>
            <ul class="space-y-2.5 text-sm">
              {socials.map((s) =>
                s.url ? (
                  <li>
                    <a href={s.url} data-cursor="hover" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2.5 text-stone transition-colors hover:text-accent">
                      {s.icon && (
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d={s.icon} /></svg>
                      )}
                      <span class="link-line">{s.platform}</span> <span aria-hidden="true" class="inline-block transition-transform duration-200 group-hover:translate-x-0.5">↗</span>
                    </a>
                  </li>
                ) : (
                  <li><span class="text-stone">{s.label}</span></li>
                )
              )}
            </ul>
          </dd>
        </div>
      </dl>
    </aside>
  </section>

  <script>
    const params = new URLSearchParams(window.location.search);
    if (params.get('success') === 'true') {
      const form = document.getElementById('contact-form-wrap');
      const thanks = document.getElementById('thank-you-panel');
      if (form && thanks) {
        form.style.transition = 'height 400ms ease, opacity 300ms ease';
        form.style.height = form.offsetHeight + 'px';
        requestAnimationFrame(() => {
          form.style.height = '0px';
          form.style.opacity = '0';
          form.style.overflow = 'hidden';
        });
        window.setTimeout(() => {
          form.style.display = 'none';
          thanks.classList.remove('hidden');
        }, 420);
      }
    }
  </script>
</BaseLayout>
