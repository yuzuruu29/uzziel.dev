---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../islands/Hero.tsx';
import AboutTeaser from '../components/AboutTeaser.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Marquee from '../components/Marquee.astro';
import KonamiEgg from '../islands/KonamiEgg.tsx';

const all = await getCollection('work');
const sampleSlugs = new Set([
  'willow-creek-farmstay',
  'clearpath-lawn-care',
  'harvest-table-kitchen',
  'ai-book-content-portfolio',
  'ai-youtube-thumbnail-design-portfolio',
]);
const projects = all.filter((entry) => !sampleSlugs.has(entry.slug));
const featured = all
  .filter((e) => e.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
const activeCount = projects.filter((entry) => entry.data.status === 'in-progress').length;
const shippedCount = projects.filter((entry) => ['live', 'completed'].includes(entry.data.status)).length;
---

<BaseLayout
  title="Uzziel Malolos — Product builder and full-stack creator"
  description="Full-stack creator and ACEU AI Solutions co-founder from Bay, Laguna. I design, build, and ship."
>
  <Hero
    client:load
    projectCount={projects.length}
    activeCount={activeCount}
    shippedCount={shippedCount}
  />
  <Marquee />

  <!-- 01 · Selected work -->
  <section class="container py-20 md:py-28">
    <div class="ledger-head" data-reveal>
      <p class="eyebrow">01 · Selected work</p>
      <p class="meta-mono hidden sm:block">Six of {projects.length} projects</p>
    </div>

    <div class="grid gap-6 pt-10 pb-12 md:grid-cols-[1fr_340px] md:items-end md:pb-14">
      <h2 class="max-w-2xl" data-reveal>
        Built, not just drafted. <em class="text-accent">Used, not just shipped.</em>
      </h2>
      <div class="md:justify-self-end" data-reveal data-reveal-delay="120">
        <p class="max-w-sm text-sm leading-relaxed text-stone">
          A working set across agent systems, indie games, local-first tools, Philippine SME sites, and mobile products.
        </p>
      </div>
    </div>

    <WorkGrid entries={featured} id="featured-grid" variant="editorial" />

    <div class="mt-12 flex justify-center" data-reveal>
      <a href="/work" data-cursor="hover" data-magnetic class="button-secondary">
        Browse all {projects.length} projects
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <AboutTeaser />

  <KonamiEgg client:idle />
</BaseLayout>
