---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CursorCompanion from '../islands/CursorCompanion.tsx';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: string;
}

const {
  title = 'Uzziel Malolos — Agri-econ × Code',
  description = 'Portfolio of Emmanuel Uzziel A. Malolos: agricultural economics, freelance dev, and indie games.',
  image = '/og-default.svg',
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://uzziel.dev');
const ogImage = new URL(image, Astro.site ?? 'https://uzziel.dev').toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1410" />
    <link rel="canonical" href={canonical.toString()} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,ital,wght@9..144,0..1,300..900&family=Inter+Tight:wght@300..700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <ViewTransitions />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('uzziel-theme');
          const dark = saved
            ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.classList.add('dark');
        } catch (_) {}
      })();
    </script>

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    <style is:global>
      :where(a, button, [role="button"], input, select, textarea, summary, [tabindex="0"]):focus-visible {
        outline: 2px solid #c9a14a;
        outline-offset: 2px;
        border-radius: 2px;
      }
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        z-index: 100;
        padding: 0.5rem 1rem;
        background: #1a1410;
        color: #f4ecd8;
        border-radius: 0.375rem;
        font-weight: 500;
        transition: top 180ms ease;
      }
      .skip-link:focus {
        top: 1rem;
      }
    </style>
  </head>
  <body class="bg-cream text-ink dark:bg-ink dark:text-cream antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main" transition:animate="slide">
      <slot />
    </main>
    <Footer />
    <CursorCompanion client:load />

    <script>
      import Lenis from 'lenis';
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced) {
        const lenis = new Lenis({ duration: 1.1, smoothWheel: true });
        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }
    </script>
  </body>
</html>
