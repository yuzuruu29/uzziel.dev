---
const items = [
  'Astro',
  'React',
  'Next.js',
  'TypeScript',
  'Flutter',
  'Godot',
  'GDScript',
  'Python',
  'FastAPI',
  'Kotlin',
  'Jetpack Compose',
  'Phaser',
  'WebRTC',
  'Supabase',
  'Botpress',
  'Claude',
  'Tailwind',
  'Netlify',
  'Aseprite',
  'Excel',
  'Figma',
];
const doubled = [...items, ...items];
---

<div class="marquee" aria-label="Tools I work with" role="region">
  <div class="track" aria-hidden="true">
    {doubled.map((label) => (
      <span class="item font-mono text-[11px] uppercase tracking-[0.2em] text-stone">
        {label}
        <span class="px" aria-hidden="true"></span>
      </span>
    ))}
  </div>
  <ul class="sr-only">
    {items.map((label) => <li>{label}</li>)}
  </ul>
</div>

<style>
  .marquee {
    --fade: 80px;
    position: relative;
    overflow: hidden;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--border);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 var(--fade), #000 calc(100% - var(--fade)), transparent 100%);
            mask-image: linear-gradient(to right, transparent 0, #000 var(--fade), #000 calc(100% - var(--fade)), transparent 100%);
  }
  .track {
    display: inline-flex;
    gap: 2.25rem;
    white-space: nowrap;
    animation: scroll-x 44s linear infinite;
    will-change: transform;
  }
  .item {
    display: inline-flex;
    align-items: center;
    gap: 2.25rem;
  }
  /* Pixel-square separator — the dither motif at word scale. */
  .px {
    width: 5px;
    height: 5px;
    background: var(--gold);
    flex: none;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  @keyframes scroll-x {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
  }
</style>
