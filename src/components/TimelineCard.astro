---
interface Entry {
  year: string;
  text: string;
}
interface Props {
  entries: Entry[];
}
const { entries } = Astro.props as Props;

const ROW_H = 96;
const TOP_PAD = 24;
const BOTTOM_PAD = 24;
const totalH = TOP_PAD + entries.length * ROW_H + BOTTOM_PAD;
---

<div class="relative max-w-3xl mx-auto" id="timeline-root">
  <svg
    class="absolute left-1/2 -translate-x-1/2 top-0 pointer-events-none"
    width="2"
    height={totalH}
    viewBox={`0 0 2 ${totalH}`}
    aria-hidden="true"
  >
    <line
      id="timeline-line"
      x1="1" y1="0" x2="1" y2={totalH}
      stroke="#6b3410"
      stroke-width="2"
      stroke-dasharray={totalH}
      stroke-dashoffset={totalH}
    />
  </svg>

  <ul class="relative" style={`min-height:${totalH}px;`}>
    {entries.map((e, i) => {
      const isLeft = i % 2 === 0;
      return (
        <li
          class:list={[
            'absolute w-full flex',
            isLeft ? 'justify-start' : 'justify-end',
          ]}
          style={`top:${TOP_PAD + i * ROW_H}px;`}
        >
          <div
            class:list={[
              'relative w-[calc(50%-1.5rem)] rounded-md border border-stone/30 bg-cream/40 dark:bg-ink/40 backdrop-blur-sm p-4',
              isLeft ? 'mr-auto' : 'ml-auto',
            ]}
            data-reveal
            data-reveal-delay={i * 90}
          >
            <p class="font-mono text-xs text-gold mb-1">{e.year}</p>
            <p class="text-sm leading-relaxed">{e.text}</p>
            <span
              class:list={[
                'absolute top-4 w-3 h-3 rounded-full bg-gold border-2 border-cream dark:border-ink',
                isLeft ? '-right-[calc(1.5rem+0.375rem)]' : '-left-[calc(1.5rem+0.375rem)]',
              ]}
              aria-hidden="true"
            />
          </div>
        </li>
      );
    })}
  </ul>
</div>

<script is:inline define:vars={{ totalH }}>
  (() => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const root = document.getElementById('timeline-root');
    const line = document.getElementById('timeline-line');
    if (!root || !line) return;
    if (reduced) {
      line.setAttribute('stroke-dashoffset', '0');
      return;
    }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          line.style.transition = 'stroke-dashoffset 1400ms cubic-bezier(0.22, 1, 0.36, 1)';
          line.setAttribute('stroke-dashoffset', '0');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    io.observe(root);
  })();
</script>
