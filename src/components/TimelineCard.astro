---
interface Entry {
  year: string;
  text: string;
}
interface Props {
  entries: Entry[];
}
const { entries } = Astro.props as Props;
---

<div class="relative" id="timeline-root">
  <div
    id="timeline-line"
    class="absolute bottom-2 left-[3px] top-2 w-px origin-top bg-narra/50 dark:bg-gold/40"
    aria-hidden="true"
  ></div>

  <ol>
    {entries.map((e, i) => (
      <li
        class="relative border-b border-line py-6 pl-10 last:border-b-0 md:grid md:grid-cols-[7rem_1fr] md:gap-8 md:pl-12"
        data-reveal
        data-reveal-delay={i * 80}
      >
        <span class="absolute left-0 top-[2.15rem] h-[7px] w-[7px] bg-gold" aria-hidden="true"></span>
        <p class="font-display text-2xl leading-none text-accent md:text-3xl">{e.year}</p>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-stone md:mt-1.5 md:text-base">{e.text}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  #timeline-line {
    transform: scaleY(0);
  }
</style>

<script is:inline>
  (() => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const root = document.getElementById('timeline-root');
    const line = document.getElementById('timeline-line');
    if (!root || !line) return;
    if (reduced || !('IntersectionObserver' in window)) {
      line.style.transform = 'scaleY(1)';
      return;
    }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          line.style.transition = 'transform 1400ms cubic-bezier(0.22, 1, 0.36, 1)';
          line.style.transform = 'scaleY(1)';
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    io.observe(root);
  })();
</script>
