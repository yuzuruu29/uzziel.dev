---
import ThemeToggle from '../islands/ThemeToggle.tsx';

const links = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/cv', label: 'CV' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact' },
];
const pathname = Astro.url.pathname;
---

<header id="site-nav" class="sticky top-0 z-40 border-b border-line bg-cream dark:bg-ink">
  <div class="container flex min-h-[72px] items-center justify-between gap-6">
    <a href="/" data-cursor="hover" class="group flex min-h-11 items-center gap-3" aria-label="uzziel.dev home">
      <span class="font-display text-2xl font-medium tracking-tight">uzziel<span class="text-gold">.</span></span>
      <span class="hidden border-l border-line-strong pl-3 font-mono text-[9px] uppercase leading-[1.5] tracking-[0.18em] text-stone sm:block">
        Bay · Laguna<br />14.18°N — 121.28°E
      </span>
    </a>

    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Primary navigation">
      {links.map((link, index) => {
        const active = pathname.startsWith(link.href);
        return (
          <a
            href={link.href}
            data-cursor="hover"
            aria-current={active ? 'page' : undefined}
            class:list={[
              'group relative inline-flex min-h-11 items-center gap-1.5 px-3.5 font-mono text-[11px] uppercase tracking-[0.15em] transition-colors',
              active ? 'text-accent' : 'text-stone hover:text-accent',
            ]}
          >
            <span class="text-[8px] opacity-60" aria-hidden="true">0{index + 1}</span>
            {link.label}
            <span
              aria-hidden="true"
              class:list={[
                'absolute inset-x-3.5 bottom-2.5 h-px origin-left bg-gold transition-transform duration-300 ease-out',
                active ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100',
              ]}
            ></span>
          </a>
        );
      })}
      <span class="ml-3 border-l border-line-strong pl-4"><ThemeToggle client:load /></span>
    </nav>

    <button
      id="mobile-menu-btn"
      type="button"
      class="inline-flex h-11 w-11 items-center justify-center rounded-[2px] border border-line-strong lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-overlay"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="7" x2="21" y2="7"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="17" x2="21" y2="17"/></svg>
    </button>
  </div>
</header>

<div
  id="mobile-overlay"
  class="section-ink fixed inset-0 z-50 flex-col lg:hidden"
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label="Site menu"
>
  <div class="container flex min-h-[72px] items-center justify-between border-b border-line">
    <span class="font-display text-2xl font-medium">uzziel<span class="text-gold">.</span></span>
    <button id="mobile-close-btn" type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-[2px] border border-line-strong" aria-label="Close menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <div class="container relative flex-1 overflow-y-auto py-10">
    <p class="meta-mono mb-6">Index</p>
    <nav class="flex flex-col stagger-in" aria-label="Mobile navigation">
      {links.map((link, index) => (
        <a href={link.href} class="group flex min-h-16 items-center justify-between gap-4 border-b border-line py-4 font-display text-4xl transition-colors hover:text-gold">
          <span class="flex items-baseline gap-4">
            <span class="font-mono text-[10px] tracking-[0.2em] text-gold" aria-hidden="true">0{index + 1}</span>
            {link.label}
          </span>
          <span class="font-mono text-lg text-stone transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      ))}
    </nav>

    <div class="mt-10 flex flex-wrap items-end justify-between gap-6">
      <div class="text-sm text-stone">
        <p class="meta-mono">Bay · Laguna — 14.18°N, 121.28°E</p>
        <p class="mt-3 max-w-[26ch] leading-relaxed">Products, games, and useful websites from one working desk.</p>
      </div>
      <ThemeToggle client:load />
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    // Delegated so the menu keeps working after Astro view transitions
    // (the header DOM is replaced on navigation; document listeners are not).
    if (window.__uzNavBound) return;
    window.__uzNavBound = true;

    let previousFocus = null;

    const getOverlay = () => document.getElementById('mobile-overlay');
    const getButton = () => document.getElementById('mobile-menu-btn');
    const getFocusable = (overlay) => Array.from(
      overlay?.querySelectorAll('a, button, [tabindex]:not([tabindex="-1"])') ?? []
    );

    const openMenu = () => {
      const overlay = getOverlay();
      const button = getButton();
      if (!overlay || !button) return;
      previousFocus = document.activeElement;
      overlay.dataset.open = 'true';
      overlay.setAttribute('aria-hidden', 'false');
      button.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      document.getElementById('mobile-close-btn')?.focus();
    };

    const closeMenu = (restoreFocus = true) => {
      const overlay = getOverlay();
      const button = getButton();
      if (!overlay || overlay.dataset.open !== 'true') return;
      overlay.dataset.open = 'false';
      overlay.setAttribute('aria-hidden', 'true');
      button?.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      if (restoreFocus && previousFocus instanceof HTMLElement) previousFocus.focus();
    };

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('#mobile-menu-btn')) { openMenu(); return; }
      if (target.closest('#mobile-close-btn')) { closeMenu(); return; }
      if (target.closest('#mobile-overlay a')) closeMenu(false);
    });

    document.addEventListener('keydown', (event) => {
      const overlay = getOverlay();
      if (overlay?.dataset.open !== 'true') return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu();
        return;
      }
      if (event.key !== 'Tab') return;
      const focusable = getFocusable(overlay);
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    });

    // A swap while the menu is open would otherwise leave scroll locked.
    document.addEventListener('astro:after-swap', () => {
      document.documentElement.style.overflow = '';
    });
  })();
</script>
