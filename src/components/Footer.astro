---
const links = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/research', label: 'Research' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="mt-32 border-t border-stone/20">
  <div class="container grid grid-cols-1 md:grid-cols-3 gap-10 py-16">
    <div>
      <p class="font-display text-xl">uzziel<span class="text-gold">.</span></p>
      <p class="mt-3 text-sm text-stone max-w-xs">
        Agri-econ undergrad and full-stack creator from Bay, Laguna. I research, build, and ship.
      </p>
    </div>

    <div>
      <p class="text-xs uppercase tracking-widest text-stone mb-3">Site</p>
      <ul class="space-y-2">
        {links.map((l) => (
          <li>
            <a href={l.href} data-cursor="hover" class="text-sm hover:text-gold transition-colors">{l.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-xs uppercase tracking-widest text-stone mb-3">Elsewhere</p>
      <ul class="space-y-2 text-sm">
        <li><span class="text-stone">GitHub — coming soon</span></li>
        <li><span class="text-stone">LinkedIn — coming soon</span></li>
        <li><span class="text-stone">itch.io — coming soon</span></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-stone/20">
    <div class="container py-6 text-xs text-stone flex flex-wrap gap-2 justify-between">
      <span>© 2026 Uzziel Malolos · Bay, Laguna · Built with Astro</span>
      <span class="font-mono">v0.1</span>
    </div>
  </div>
</footer>
