---
import { socials } from '../lib/socials';

const links = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/cv', label: 'CV' },
  { href: '/research', label: 'Research' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact' },
];
const footerSocials = socials.filter((social) => ['GitHub', 'LinkedIn', 'itch.io'].includes(social.platform));
const year = new Date().getFullYear();
---

<footer class="mt-28 border-t border-stone/20 bg-ink text-cream" data-reveal>
  <div class="container grid gap-12 py-14 md:grid-cols-[1.35fr_0.65fr] md:py-20">
    <div>
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-gold">From Bay, Laguna</p>
      <h2 class="mt-4 max-w-2xl text-4xl text-cream md:text-5xl">Research-backed. Built to run.</h2>
      <p class="mt-5 max-w-xl leading-relaxed text-cream/65">
        Available for focused product builds, web work, automation, and research collaborations.
      </p>
      <a href="/contact" data-cursor="hover" class="group mt-8 inline-flex min-h-12 items-center gap-2 rounded-lg bg-gold px-5 py-3 font-semibold text-ink transition-transform duration-200 hover:-translate-y-0.5">
        Start a conversation <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">↗</span>
      </a>
    </div>

    <div class="grid grid-cols-2 gap-8 border-t border-cream/15 pt-8 md:border-l md:border-t-0 md:pl-10 md:pt-0">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-cream/55">Site</p>
        <ul class="mt-4 space-y-2.5">
          {links.map((link) => (
            <li><a href={link.href} data-cursor="hover" class="text-sm text-cream/75 transition-colors hover:text-gold">{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-cream/55">Elsewhere</p>
        <ul class="mt-4 space-y-2.5">
          {footerSocials.map((social) => (
            <li>
              {social.url ? (
                <a href={social.url} data-cursor="hover" target="_blank" rel="noopener noreferrer" class="group text-sm text-cream/75 transition-colors hover:text-gold">
                  {social.platform} <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">↗</span>
                </a>
              ) : (
                <span class="text-sm text-cream/55">{social.label}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-cream/15">
    <div class="container flex flex-wrap justify-between gap-3 py-6 font-mono text-[10px] uppercase tracking-wider text-cream/55">
      <span>© {year} Emmanuel Uzziel A. Malolos</span>
      <span>Astro · React · Built in the Philippines</span>
    </div>
  </div>
</footer>
