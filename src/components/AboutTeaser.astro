---
const bio = "I'm Uzziel — I study agricultural land use at UPLB, build indie games and AI tools, and ship websites for clients and my church. Right now: Yusel AI, a Flutter pomodoro app called Ponggi, two Godot games in parallel, and a thesis on land conversion in Bay, Laguna.";
---

<section class="container py-24">
  <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-10 md:gap-14 items-center">
    <div class="mx-auto md:mx-0">
      <img
        src="/photos/uzziel-jeepney.jpg"
        alt="Uzziel during a jeepney commute from campus to Bay"
        width="360"
        height="360"
        loading="eager"
        decoding="async"
        class="block w-[240px] h-[240px] md:w-[320px] md:h-[320px] object-cover rounded-md border-2 border-narra"
      />
    </div>

    <div>
      <p class="text-xs uppercase tracking-widest text-stone mb-3">About</p>
      <p class="font-display text-2xl md:text-3xl leading-snug">
        {bio}
      </p>
      <a
        href="/about"
        data-cursor="hover"
        class="group inline-flex items-center gap-2 mt-8 font-medium text-gold hover:text-gold"
      >
        More about me
        <span
          aria-hidden="true"
          class="inline-block transition-transform duration-300 group-hover:translate-x-1"
        >→</span>
      </a>
    </div>
  </div>
</section>
