---
// Home page: Levi Co. studio band (co-founder showcase) + practice section.
const method = [
  { n: '01', title: 'Frame', text: 'Real constraints, useful scope, clear outcomes. The problem gets written down before anything gets built.' },
  { n: '02', title: 'Build', text: 'Web, mobile, desktop, agent systems. Legible code, data-driven content, working drafts you can react to.' },
  { n: '03', title: 'Ship', text: 'Tests, handoffs, deployment, iteration. A thing counts when someone else can run it without me.' },
];
---

<!-- The studio — full-bleed navy band in Levi Co.'s own blue palette -->
<section class="relative" aria-labelledby="levi-studio-title">
  <div class="dither-up" style="background: #061632;" aria-hidden="true"></div>
  <div class="relative overflow-hidden bg-[#061632] text-white">
    <div
      class="absolute inset-0 bg-[linear-gradient(rgba(111,160,230,0.06)_1px,transparent_1px),linear-gradient(90deg,rgba(111,160,230,0.06)_1px,transparent_1px)] bg-[size:44px_44px]"
      aria-hidden="true"
    ></div>
    <div class="absolute -right-24 -top-24 h-96 w-96 rounded-full bg-[#3468bd]/25 blur-3xl" aria-hidden="true"></div>

    <div class="container relative py-16 md:py-24">
      <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-white/10 pb-4" data-reveal>
        <p class="font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-[#8db6ee]">03 · The studio</p>
        <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-white/40">Co-founder · Design & engineering</p>
      </div>

      <div class="grid gap-12 pt-12 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="lg:col-span-7" data-reveal>
          <p class="flex items-center gap-3 font-sans text-3xl font-semibold tracking-[-0.04em] text-white md:text-4xl">
            <img src="/logos/levi-co.webp" alt="" width="52" height="40" class="h-8 w-auto md:h-10" />
            Levi Co.
            <span class="ml-1 font-mono text-[10px] font-medium uppercase tracking-[0.24em] text-white/50">Ideas to impact</span>
          </p>
          <h2
            id="levi-studio-title"
            class="mt-7 max-w-2xl font-sans font-semibold leading-[1.04] tracking-[-0.045em] text-white"
            style="font-size: clamp(2rem, 4.4vw, 3.5rem);"
          >
            Websites, apps, and business software, built by three founders.
          </h2>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-white/65">
            I co-founded Levi Co. with Philip James Lizardo and Aaron Christian Panergayo. We're an independent team in the Philippines building websites, apps, business software, games, and automations.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="https://levi-co-official.comtus-ai.xyz"
              target="_blank"
              rel="noopener noreferrer"
              data-cursor="hover"
              data-cursor-label="Visit studio"
              data-magnetic
              class="inline-flex min-h-12 items-center gap-2 rounded-[2px] bg-[#0b4db0] px-5 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-white transition-colors hover:bg-[#2160c4]"
            >
              Visit Levi Co. <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="relative lg:col-span-5" data-reveal data-reveal-delay="120">
          <div class="relative mx-auto w-full max-w-[15rem] sm:max-w-sm" aria-hidden="true">
            <div class="absolute inset-[12%] rounded-full bg-[#3468bd]/30 blur-3xl"></div>
            <img src="/logos/levi-co.webp" alt="" width="720" height="557" loading="lazy" decoding="async" class="relative w-full" />
          </div>
          <dl class="mt-8 grid grid-cols-2 gap-4 border-t border-white/10 pt-5 font-mono text-[10px] uppercase tracking-[0.14em]">
            <div>
              <dt class="text-white/40">Founders</dt>
              <dd class="mt-1.5 text-white/75">Malolos · Lizardo · Panergayo</dd>
            </div>
            <div>
              <dt class="text-white/40">Builds</dt>
              <dd class="mt-1.5 text-white/75">Websites · Apps · Automations</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </div>
  <div class="dither-down" style="background: #061632;" aria-hidden="true"></div>
</section>

<!-- The practice -->
<section class="container py-20 md:py-28">
  <div class="ledger-head" data-reveal>
    <p class="eyebrow">04 · The practice</p>
    <p class="meta-mono hidden sm:block">Frame → Build → Ship</p>
  </div>

  <div class="grid gap-12 pt-12 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5" data-reveal>
      <h2 class="max-w-md">The subject changes. <em class="text-accent">The method stays practical.</em></h2>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-stone">
        I build local-first tools, indie games, and websites for small organizations. The common thread is practical delivery: understand the real constraint, make the system legible, then test the result.
      </p>
      <a href="/about" data-cursor="hover" data-magnetic class="button-secondary mt-9">
        Read the full story
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <dl class="lg:col-span-7">
      {method.map((step, i) => (
        <div
          class="grid grid-cols-[3.5rem_1fr] items-start gap-6 border-b border-line py-7 first:border-t md:grid-cols-[4.5rem_10rem_1fr] md:gap-8"
          data-reveal
          data-reveal-delay={i * 90}
        >
          <span class="font-display text-3xl text-gold md:text-4xl" aria-hidden="true">{step.n}</span>
          <dt class="font-display text-2xl leading-tight">{step.title}</dt>
          <dd class="col-span-2 -mt-2 text-sm leading-relaxed text-stone md:col-span-1 md:mt-1">{step.text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
